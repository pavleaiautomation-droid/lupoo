# Local website: copy to .dev.vars. CLI: also copy to .env.
# Preview stores subscribers but sends no email. Set to live after configuring Resend.
EMAIL_MODE=preview
RESEND_API_KEY=
EMAIL_FROM=
SITE_URL=http://localhost:3000
LAUNCH_URL=
# Generate a random value of at least 32 characters. Never prefix secrets with NEXT_PUBLIC_.
ADMIN_TOKEN=

# Read-only subscriber dashboard password (minimum 32 characters).
SUBSCRIBERS_PASSWORD=
